# 复制到服务器 /opt/canteen/canteen.env 后填写真实值
# 该文件包含密钥，只留在服务器上：chown canteen:canteen 且 chmod 600，不要提交进仓库
SPRING_PROFILES_ACTIVE=prod

# ---------------- MySQL ----------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=canteen_nutrition
MYSQL_USERNAME=canteen
# 不要用 root 跑应用；建一个只对 canteen_nutrition 有权限的账号，口令自拟
MYSQL_PASSWORD=CHANGE_ME_DB_PASSWORD

# ---------------- Redis ----------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
# Redis 只监听 127.0.0.1 时可留空；若开了公网必须设密码并在 redis.conf 里改 bind
REDIS_PASSWORD=

# ---------------- JWT ----------------
# 生产必须换掉默认值，否则等于用公开的密钥签发令牌（泄露时改这一处即可让全部令牌失效）
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS

# ---------------- AI 营养分析 ----------------
# 留空 OPENAI_API_KEY 时系统自动降级为内置食材估算表，基础功能不受影响
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen-plus
OPENAI_API_KEY=

# ---------------- 阿里云 OSS（菜品图片） ----------------
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_REGION=cn-beijing
OSS_BUCKET=CHANGE_ME_BUCKET
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# ---------------- JVM ----------------
# 1G 内存的小机器建议 -Xmx512m；ai.timeout-seconds 控制 AI 单次调用超时
# user.timezone 必须显式指定：Ubuntu 云主机默认 UTC，而全站的 create_time 用的是
# LocalDateTime.now()，不指定的话 20 点下的订单会被记成当天下午
# server.address=127.0.0.1：8080 只给 nginx 转，不因安全组放开而被直连绕过 nginx
JAVA_OPTS=-Dfile.encoding=UTF-8 -Duser.timezone=Asia/Shanghai -Dserver.address=127.0.0.1 -Dai.timeout-seconds=90 -Xms256m -Xmx512m
