# 后端容器的环境变量：复制到服务器上的 canteen.env 并 chmod 600，不要提交进仓库
# 主机名走 compose 内部网络，不要写 127.0.0.1（容器里的 127.0.0.1 是它自己）
SPRING_PROFILES_ACTIVE=prod

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=canteen_nutrition
MYSQL_USERNAME=canteen
MYSQL_PASSWORD=CHANGE_ME_APP_PASSWORD

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=

JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS

# 留空 OPENAI_API_KEY 时系统自动降级为内置食材估算表，基础功能不受影响
AI_BASE_URL=
AI_MODEL=
OPENAI_API_KEY=

OSS_ENDPOINT=
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# server.address 在容器里不必绑 127.0.0.1，否则 nginx 转发进不来
# preferIPv4Stack：容器里 JVM 走 IPv6 出不到 Cloudflare，AI 调用会连接超时
JAVA_OPTS=-Dfile.encoding=UTF-8 -Duser.timezone=Asia/Shanghai -Djava.net.preferIPv4Stack=true -Dai.timeout-seconds=90 -Xms256m -Xmx512m
